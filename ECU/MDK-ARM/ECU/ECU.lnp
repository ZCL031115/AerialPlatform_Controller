"ecu\stm32f1xx_it.o"
"ecu\stm32f1xx_hal_msp.o"
"ecu\stm32f1xx_hal_gpio_ex.o"
"ecu\stm32f1xx_hal_uart.o"
"ecu\stm32f1xx_hal.o"
"ecu\stm32f1xx_hal_rcc.o"
"ecu\stm32f1xx_hal_rcc_ex.o"
"ecu\stm32f1xx_hal_gpio.o"
"ecu\stm32f1xx_hal_dma.o"
